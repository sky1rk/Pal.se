# --- Supabase (backend holds zero API keys: JWTs are verified locally via JWKS.
# The publishable key sb_publishable_... is frontend-only: VITE_SUPABASE_PUBLISHABLE_KEY.)
SUPABASE_URL=https://your-project.supabase.co

# Defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json when empty.
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUD=authenticated

# --- Database ---
# Single URL for BOTH runtime and Alembic migrations: async SQLAlchemy + asyncpg
# against the Supabase SESSION-mode pooler (:5432). Session mode supports
# prepared statements and DDL, unlike the transaction-mode pooler (:6543).
# Copy it from: Supabase dashboard -> Connect button (top bar) -> ORM tab
# -> session pooler string, then swap the scheme prefix to postgresql+asyncpg://
# and replace YOUR-DB-PASSWORD below with the real database password.
# NOTE the pooler username format: postgres.<project-ref> (bare "postgres"
# only works on the direct connection).
# Do NOT use the direct connection from Render (IPv4-only; direct is IPv6).
DATABASE_URL=postgresql+asyncpg://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# --- App ---
FRONTEND_ORIGIN=http://localhost:5173
