# Copy to .env to override defaults: cp .env.example .env
# All variables have working defaults, so `docker compose up --build` runs as-is.

# REQUIRED in production: long random string (min 32 chars). Dev default is insecure.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=30

POSTGRES_USER=palse
POSTGRES_PASSWORD=palse
POSTGRES_DB=palse
POSTGRES_PORT=5432

# Local frontend runs on the host: cd frontend && bun install && bun run dev
# (Vite serves http://localhost:5173 and proxies /api to the backend.)
POSTGRES_PORT=5432
