# Copy to .env to override defaults: cp .env.example .env
# All variables have working defaults, so `docker compose up --build` runs as-is.

# REQUIRED in production: long random string (min 32 chars). Dev default is insecure.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_MINUTES=60

POSTGRES_USER=palse
POSTGRES_PASSWORD=palse
POSTGRES_DB=palse
POSTGRES_PORT=5432

# Host port for the web UI (http://localhost:5173 by default).
FRONTEND_PORT=5173
